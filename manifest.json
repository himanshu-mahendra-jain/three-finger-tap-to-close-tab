{
  "manifest_version": 3,
  "name": "Three Finger Tap to Close Tab",
  "version": "1.0.2",
  "description": "Close the current tab with a three-finger tap or middle click outside links and editable fields.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Three Finger Tap to Close Tab",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Close the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}